<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_ToBe" targetNamespace="http://fluidcare-case/bpmn">

  <bpmn:collaboration id="Collab_ToBe">
    <bpmn:participant id="Pool_ICU" name="ОАР: учёт водного баланса (как стало, FluidCare)" processRef="Proc_ToBe" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_Nurse" name="Медсестра">
        <bpmn:flowNodeRef>Start_Day</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Doctor" name="Врач анестезиолог-реаниматолог">
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Shift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="FluidCare">
        <bpmn:flowNodeRef>STask_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>STask_Calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>STask_Save</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Медсестра: без изменений относительно «как было» -->
    <bpmn:startEvent id="Start_Day" name="Начались сутки наблюдения">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Start" />
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_Record" name="Фиксировать введённое и потери на бумаге">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Paper"><bpmn:targetRef>DOR_Paper</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Timer_Calc" name="Время расчёта баланса">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Calc" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Handover" name="Передать данные врачу (лист и устно)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Clarify" name="Уточнить и дописать недостающие объёмы">
      <bpmn:incoming>F_Incomplete</bpmn:incoming>
      <bpmn:outgoing>F_BackCollect</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Врач -->
    <bpmn:manualTask id="Task_Collect" name="Собрать объёмы из листа и устных сообщений">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F_BackCollect</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:property id="Prop_Collect" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Paper">
        <bpmn:sourceRef>DOR_Paper</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Collect</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Complete" name="Данные полные?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F_Incomplete</bpmn:outgoing>
      <bpmn:outgoing>F_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Enter" name="Ввести объёмы в форму FluidCare">
      <bpmn:incoming>F_Complete</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Confirm" name="Подтвердить или исправить значение">
      <bpmn:incoming>F_Unusual</bpmn:incoming>
      <bpmn:outgoing>F_Recheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Export" name="Экспортировать результат и перенести в карту">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_EMK"><bpmn:targetRef>DSR_EMK</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="Task_Shift" name="Передать смену">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Done" name="Баланс за сутки учтён">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- FluidCare -->
    <bpmn:serviceTask id="STask_Validate" name="Проверить значения по границам">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F_Recheck</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Valid" name="Значения в норме?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F_Unusual</bpmn:outgoing>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="STask_Calc" name="Рассчитать суточный и накопительный баланс">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:property id="Prop_Calc" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_History">
        <bpmn:sourceRef>DSR_DB</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Calc</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="STask_Save" name="Сохранить запись и обновить график">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_DB"><bpmn:targetRef>DSR_DB</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>

    <!-- Данные -->
    <bpmn:dataObjectReference id="DOR_Paper" name="Лист наблюдения (бумага)" dataObjectRef="DO_Paper" />
    <bpmn:dataObject id="DO_Paper" />
    <bpmn:dataStoreReference id="DSR_DB" name="БД FluidCare" />
    <bpmn:dataStoreReference id="DSR_EMK" name="Медицинская карта" />

    <!-- Аннотации: что изменилось -->
    <bpmn:textAnnotation id="Ann_Enter"><bpmn:text>Поля формы уже разделены на поступление и потери: шаг «отнести к столбцу» исчез</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Validate"><bpmn:text>Необычное значение: нужно подтверждение. Недопустимое: сохранить нельзя</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Calc"><bpmn:text>Арифметика и накопительный итог: автоматически, по истории записей</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Shift"><bpmn:text>Контекст в системе: баланс, график, предупреждения</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Enter" sourceRef="Task_Enter" targetRef="Ann_Enter" />
    <bpmn:association id="As_Validate" sourceRef="STask_Validate" targetRef="Ann_Validate" />
    <bpmn:association id="As_Calc" sourceRef="STask_Calc" targetRef="Ann_Calc" />
    <bpmn:association id="As_Shift" sourceRef="Task_Shift" targetRef="Ann_Shift" />

    <!-- Потоки управления -->
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Day" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Record" targetRef="Timer_Calc" />
    <bpmn:sequenceFlow id="F3" sourceRef="Timer_Calc" targetRef="Task_Handover" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Handover" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Collect" targetRef="GW_Complete" />
    <bpmn:sequenceFlow id="F_Incomplete" name="нет" sourceRef="GW_Complete" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="F_BackCollect" sourceRef="Task_Clarify" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F_Complete" name="да" sourceRef="GW_Complete" targetRef="Task_Enter" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Enter" targetRef="STask_Validate" />
    <bpmn:sequenceFlow id="F7" sourceRef="STask_Validate" targetRef="GW_Valid" />
    <bpmn:sequenceFlow id="F_Unusual" name="нет" sourceRef="GW_Valid" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F_Recheck" sourceRef="Task_Confirm" targetRef="STask_Validate" />
    <bpmn:sequenceFlow id="F_Valid" name="да" sourceRef="GW_Valid" targetRef="STask_Calc" />
    <bpmn:sequenceFlow id="F8" sourceRef="STask_Calc" targetRef="STask_Save" />
    <bpmn:sequenceFlow id="F9" sourceRef="STask_Save" targetRef="Task_Export" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Export" targetRef="Task_Shift" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Shift" targetRef="End_Done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_ToBe">
    <bpmndi:BPMNPlane id="Plane_ToBe" bpmnElement="Collab_ToBe">
      <bpmndi:BPMNShape id="Pool_ICU_di" bpmnElement="Pool_ICU" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1830" height="740" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Nurse_di" bpmnElement="Lane_Nurse" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1800" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Doctor_di" bpmnElement="Lane_Doctor" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="1800" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="580" width="1800" height="240" />
      </bpmndi:BPMNShape>

      <!-- Медсестра -->
      <bpmndi:BPMNShape id="Start_Day_di" bpmnElement="Start_Day">
        <dc:Bounds x="242" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="220" y="195" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Record_di" bpmnElement="Task_Record">
        <dc:Bounds x="320" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_Calc_di" bpmnElement="Timer_Calc">
        <dc:Bounds x="502" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="482" y="195" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Handover_di" bpmnElement="Task_Handover">
        <dc:Bounds x="580" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Clarify_di" bpmnElement="Task_Clarify">
        <dc:Bounds x="780" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DOR_Paper_di" bpmnElement="DOR_Paper">
        <dc:Bounds x="372" y="235" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="412" y="247" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Врач -->
      <bpmndi:BPMNShape id="Task_Collect_di" bpmnElement="Task_Collect">
        <dc:Bounds x="580" y="380" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Complete_di" bpmnElement="GW_Complete" isMarkerVisible="true">
        <dc:Bounds x="825" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="806" y="452" width="88" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Enter_di" bpmnElement="Task_Enter">
        <dc:Bounds x="920" y="380" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm">
        <dc:Bounds x="1080" y="380" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Export_di" bpmnElement="Task_Export">
        <dc:Bounds x="1590" y="380" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DSR_EMK_di" bpmnElement="DSR_EMK">
        <dc:Bounds x="1700" y="495" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1755" y="513" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Shift_di" bpmnElement="Task_Shift">
        <dc:Bounds x="1780" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="1922" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1902" y="445" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- FluidCare -->
      <bpmndi:BPMNShape id="STask_Validate_di" bpmnElement="STask_Validate">
        <dc:Bounds x="920" y="660" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Valid_di" bpmnElement="GW_Valid" isMarkerVisible="true">
        <dc:Bounds x="1125" y="675" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1103" y="732" width="94" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="STask_Calc_di" bpmnElement="STask_Calc">
        <dc:Bounds x="1240" y="660" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="STask_Save_di" bpmnElement="STask_Save">
        <dc:Bounds x="1420" y="660" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DSR_DB_di" bpmnElement="DSR_DB">
        <dc:Bounds x="1465" y="760" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1520" y="778" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Аннотации -->
      <bpmndi:BPMNShape id="Ann_Enter_di" bpmnElement="Ann_Enter">
        <dc:Bounds x="620" y="495" width="230" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Validate_di" bpmnElement="Ann_Validate">
        <dc:Bounds x="660" y="670" width="220" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Calc_di" bpmnElement="Ann_Calc">
        <dc:Bounds x="1240" y="596" width="230" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Shift_di" bpmnElement="Ann_Shift">
        <dc:Bounds x="1780" y="315" width="190" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="As_Enter_di" bpmnElement="As_Enter">
        <di:waypoint x="935" y="460" /><di:waypoint x="850" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_Validate_di" bpmnElement="As_Validate">
        <di:waypoint x="920" y="700" /><di:waypoint x="880" y="698" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_Calc_di" bpmnElement="As_Calc">
        <di:waypoint x="1270" y="660" /><di:waypoint x="1270" y="641" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_Shift_di" bpmnElement="As_Shift">
        <di:waypoint x="1830" y="380" /><di:waypoint x="1830" y="360" />
      </bpmndi:BPMNEdge>

      <!-- Ассоциации данных -->
      <bpmndi:BPMNEdge id="DOA_Paper_di" bpmnElement="DOA_Paper">
        <di:waypoint x="390" y="210" /><di:waypoint x="390" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Paper_di" bpmnElement="DIA_Paper">
        <di:waypoint x="408" y="270" /><di:waypoint x="580" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_DB_di" bpmnElement="DOA_DB">
        <di:waypoint x="1490" y="740" /><di:waypoint x="1490" y="760" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_History_di" bpmnElement="DIA_History">
        <di:waypoint x="1465" y="790" /><di:waypoint x="1440" y="790" /><di:waypoint x="1350" y="740" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_EMK_di" bpmnElement="DOA_EMK">
        <di:waypoint x="1700" y="460" /><di:waypoint x="1715" y="495" />
      </bpmndi:BPMNEdge>

      <!-- Потоки -->
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="278" y="170" /><di:waypoint x="320" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="460" y="170" /><di:waypoint x="502" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="538" y="170" /><di:waypoint x="580" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="650" y="210" /><di:waypoint x="650" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="720" y="420" /><di:waypoint x="825" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Incomplete_di" bpmnElement="F_Incomplete">
        <di:waypoint x="850" y="395" /><di:waypoint x="850" y="210" />
        <bpmndi:BPMNLabel><dc:Bounds x="858" y="355" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_BackCollect_di" bpmnElement="F_BackCollect">
        <di:waypoint x="800" y="210" /><di:waypoint x="800" y="340" /><di:waypoint x="690" y="340" /><di:waypoint x="690" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Complete_di" bpmnElement="F_Complete">
        <di:waypoint x="875" y="420" /><di:waypoint x="920" y="420" />
        <bpmndi:BPMNLabel><dc:Bounds x="888" y="402" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="990" y="460" /><di:waypoint x="990" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="1060" y="700" /><di:waypoint x="1125" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Unusual_di" bpmnElement="F_Unusual">
        <di:waypoint x="1150" y="675" /><di:waypoint x="1150" y="460" />
        <bpmndi:BPMNLabel><dc:Bounds x="1158" y="630" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Recheck_di" bpmnElement="F_Recheck">
        <di:waypoint x="1110" y="460" /><di:waypoint x="1110" y="620" /><di:waypoint x="1030" y="620" /><di:waypoint x="1030" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Valid_di" bpmnElement="F_Valid">
        <di:waypoint x="1175" y="700" /><di:waypoint x="1240" y="700" />
        <bpmndi:BPMNLabel><dc:Bounds x="1195" y="682" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1380" y="700" /><di:waypoint x="1420" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1560" y="700" /><di:waypoint x="1660" y="700" /><di:waypoint x="1660" y="460" />
      </bpmndi:BPMNEdge>
