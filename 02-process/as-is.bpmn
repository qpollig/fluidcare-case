<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_AsIs" targetNamespace="http://fluidcare-case/bpmn">

  <bpmn:collaboration id="Collab_AsIs">
    <bpmn:participant id="Pool_ICU" name="ОАР: учёт водного баланса (как было)" processRef="Proc_AsIs" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Nurse" name="Медсестра">
        <bpmn:flowNodeRef>Start_Day</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_DayEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Doctor" name="Врач анестезиолог-реаниматолог">
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Daily</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cumulative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Shift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Day" name="Начались сутки наблюдения">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Start" />
    </bpmn:startEvent>

    <bpmn:manualTask id="Task_Record" name="Фиксировать введённое и потери на бумаге">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Paper">
        <bpmn:targetRef>DOR_Paper</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:manualTask>

    <bpmn:intermediateCatchEvent id="Timer_DayEnd" name="Время расчёта баланса">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_End" />
    </bpmn:intermediateCatchEvent>

    <bpmn:manualTask id="Task_Handover" name="Передать данные врачу (лист и устно)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_Collect" name="Собрать объёмы из листа и устных сообщений">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F_Back</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:property id="Prop_Collect" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Paper">
        <bpmn:sourceRef>DOR_Paper</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Collect</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>

    <bpmn:exclusiveGateway id="GW_Complete" name="Данные полные?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F_No</bpmn:outgoing>
      <bpmn:outgoing>F_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:manualTask id="Task_Clarify" name="Уточнить и дописать недостающие объёмы">
      <bpmn:incoming>F_No</bpmn:incoming>
      <bpmn:outgoing>F_Back</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_Classify" name="Отнести каждый объём к поступлению или потерям">
      <bpmn:incoming>F_Yes</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_Daily" name="Рассчитать суточный баланс вручную">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_Cumulative" name="Пересчитать накопительный баланс">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_Transfer" name="Перенести результат в медицинскую карту">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_EMK">
        <bpmn:targetRef>DSR_EMK</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>

    <bpmn:task id="Task_Shift" name="Передать смену">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Done" name="Баланс за сутки учтён">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObjectReference id="DOR_Paper" name="Лист наблюдения (бумага)" dataObjectRef="DO_Paper" />
    <bpmn:dataObject id="DO_Paper" />
    <bpmn:dataStoreReference id="DSR_EMK" name="Медицинская карта" />

    <bpmn:textAnnotation id="Ann_Classify"><bpmn:text>Риск: не тот столбец, двойной учёт, пропуск</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Daily"><bpmn:text>Риск: арифметическая ошибка в конце смены</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Shift"><bpmn:text>Риск: потеря контекста при передаче смены</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Classify" sourceRef="Task_Classify" targetRef="Ann_Classify" />
    <bpmn:association id="As_Daily" sourceRef="Task_Daily" targetRef="Ann_Daily" />
    <bpmn:association id="As_Shift" sourceRef="Task_Shift" targetRef="Ann_Shift" />

    <bpmn:sequenceFlow id="F1" sourceRef="Start_Day" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Record" targetRef="Timer_DayEnd" />
    <bpmn:sequenceFlow id="F3" sourceRef="Timer_DayEnd" targetRef="Task_Handover" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Handover" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Collect" targetRef="GW_Complete" />
    <bpmn:sequenceFlow id="F_No" name="нет" sourceRef="GW_Complete" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="F_Back" sourceRef="Task_Clarify" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F_Yes" name="да" sourceRef="GW_Complete" targetRef="Task_Classify" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Classify" targetRef="Task_Daily" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Daily" targetRef="Task_Cumulative" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Cumulative" targetRef="Task_Transfer" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Transfer" targetRef="Task_Shift" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Shift" targetRef="End_Done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_AsIs">
    <bpmndi:BPMNPlane id="Plane_AsIs" bpmnElement="Collab_AsIs">
      <bpmndi:BPMNShape id="Pool_ICU_di" bpmnElement="Pool_ICU" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1700" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Nurse_di" bpmnElement="Lane_Nurse" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1670" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Doctor_di" bpmnElement="Lane_Doctor" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="1670" height="280" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Day_di" bpmnElement="Start_Day">
        <dc:Bounds x="242" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="220" y="185" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Record_di" bpmnElement="Task_Record">
        <dc:Bounds x="320" y="120" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_DayEnd_di" bpmnElement="Timer_DayEnd">
        <dc:Bounds x="502" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="482" y="185" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Handover_di" bpmnElement="Task_Handover">
        <dc:Bounds x="580" y="120" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Clarify_di" bpmnElement="Task_Clarify">
        <dc:Bounds x="780" y="120" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DOR_Paper_di" bpmnElement="DOR_Paper">
        <dc:Bounds x="372" y="240" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="412" y="252" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Collect_di" bpmnElement="Task_Collect">
        <dc:Bounds x="580" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Complete_di" bpmnElement="GW_Complete" isMarkerVisible="true">
        <dc:Bounds x="825" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="810" y="472" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Classify_di" bpmnElement="Task_Classify">
        <dc:Bounds x="930" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Daily_di" bpmnElement="Task_Daily">
        <dc:Bounds x="1110" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cumulative_di" bpmnElement="Task_Cumulative">
        <dc:Bounds x="1290" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Transfer_di" bpmnElement="Task_Transfer">
        <dc:Bounds x="1470" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DSR_EMK_di" bpmnElement="DSR_EMK">
        <dc:Bounds x="1515" y="525" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1570" y="543" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Shift_di" bpmnElement="Task_Shift">
        <dc:Bounds x="1650" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="1772" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1752" y="465" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Ann_Classify_di" bpmnElement="Ann_Classify">
        <dc:Bounds x="930" y="520" width="160" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Daily_di" bpmnElement="Ann_Daily">
        <dc:Bounds x="1110" y="520" width="160" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Shift_di" bpmnElement="Ann_Shift">
        <dc:Bounds x="1650" y="333" width="170" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="As_Classify_di" bpmnElement="As_Classify">
        <di:waypoint x="1000" y="480" /><di:waypoint x="1000" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_Daily_di" bpmnElement="As_Daily">
        <di:waypoint x="1180" y="480" /><di:waypoint x="1180" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_Shift_di" bpmnElement="As_Shift">
        <di:waypoint x="1700" y="400" /><di:waypoint x="1700" y="378" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DOA_Paper_di" bpmnElement="DOA_Paper">
        <di:waypoint x="390" y="200" /><di:waypoint x="390" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Paper_di" bpmnElement="DIA_Paper">
        <di:waypoint x="408" y="275" /><di:waypoint x="580" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_EMK_di" bpmnElement="DOA_EMK">
        <di:waypoint x="1540" y="480" /><di:waypoint x="1540" y="525" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="278" y="160" /><di:waypoint x="320" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="460" y="160" /><di:waypoint x="502" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="538" y="160" /><di:waypoint x="580" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="650" y="200" /><di:waypoint x="650" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="720" y="440" /><di:waypoint x="825" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_No_di" bpmnElement="F_No">
        <di:waypoint x="850" y="415" /><di:waypoint x="850" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="858" y="370" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Back_di" bpmnElement="F_Back">
        <di:waypoint x="800" y="200" /><di:waypoint x="800" y="360" /><di:waypoint x="690" y="360" /><di:waypoint x="690" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Yes_di" bpmnElement="F_Yes">
        <di:waypoint x="875" y="440" /><di:waypoint x="930" y="440" />
        <bpmndi:BPMNLabel><dc:Bounds x="895" y="422" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="1070" y="440" /><di:waypoint x="1110" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="1250" y="440" /><di:waypoint x="1290" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1430" y="440" /><di:waypoint x="1470" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1610" y="440" /><di:waypoint x="1650" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1750" y="440" /><di:waypoint x="1772" y="440" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>